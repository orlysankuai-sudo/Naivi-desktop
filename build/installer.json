{
  "appId": "asia.sankuai.naivi",
  "productName": "Naivi",
  "directories": {
    "output": "dist/4.0.1"
  },
  "artifactName": "Naivi-${version}-Setup-Windows-${arch}.${ext}",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "src/renderer/naivi.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "shortcutName": "Naivi",
    "license": "LICENSE",
    "installerLanguages": [
      "en_US",
      "zh_TW",
      "zh_CN"
    ],
    "displayLanguageSelector": true
  },
  "forceCodeSigning": false
}
